# Contact form (https://resend.com)
RESEND_API_KEY=
# Where messages are delivered (defaults to seinprince2@gmail.com)
CONTACT_TO_EMAIL=
# Sender. Use a verified domain in production; the default works for testing only.
CONTACT_FROM_EMAIL=

# Optional: higher GitHub API limits for the home page stats
# Set to true to show Resend's explanation when a send fails (owner debugging only)
CONTACT_DEBUG=

GITHUB_TOKEN=
GITHUB_USERNAME=sein-pr
